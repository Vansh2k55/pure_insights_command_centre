    "/reports": {
      "get": {
        "summary": "Filter and paginate scoped reports",
        "operationId": "get_reports",
        "x-roles": ["admin", "engineer", "analyst", "viewer", "owner"],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Role, origin, header or demo restriction"
          },
          "404": {
            "description": "Not found or out of scope"
          },
          "409": {
            "description": "State conflict"
          },
          "429": {
            "description": "Rate limit"
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["SUCCESS", "FAILED", "TIMED_OUT", "UNKNOWN"]
            }
          },
          {
            "name": "orphan",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["true", "false"]
            }
          },
          {
            "name": "slow",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["true", "false"]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 12
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "report_id",
                "report_name",
                "monthly_active_views",
                "avg_load_time_sec",
                "total_cost_usd",
                "cost_per_view_usd"
              ],
              "default": "report_id"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"],
              "default": "asc"
            }
          }
        ]
      }
    },
