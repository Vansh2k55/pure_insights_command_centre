# Node does not automatically load this file. Start: node --env-file=.env server/index.js
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
DB_PATH=./runtime/insights.sqlite
DEMO_MODE=true
# Optional: overrides built-in demo password for the five demo users on FIRST DB creation.
# Set a strong value before exposing to a network. Existing users are not silently reset.
DEMO_PASSWORD=InsightsDemo2026!
# Real negotiated credit price is not provided; this is a labelled assumption.
CREDIT_PRICE_USD=3
COOKIE_SECURE=false
